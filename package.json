{
  "name": "pimath",
  "version": "0.2.9",
  "description": "A math library for teacher :)",
  "type": "module",
  "main": "dist/pimath.js",
  "module": "dist/pimath.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/pimath.js",
      "require": "./dist/pimath.js"
    }
  },
  "./types/index.d.ts": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "dev": "vite serve",
    "test": "vitest",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "preview": "vite preview",
    "docs": "typedoc",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg"
  },
  "keywords": [
    "math",
    "algebra"
  ],
  "author": "Basil Gass",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilgass/PiMath.git"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/eslint": "^9.6.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.2",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-router": "^5.1.0"
  },
  "dependencies": {
    "piexpression": "^0.1.3"
  }
}
