{
  "name": "pimath",
  "version": "0.3.0",
  "description": "A math library for teacher :)",
  "type": "module",
  "main": "dist/pimath.js",
  "module": "dist/pimath.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/pimath.js",
      "require": "./dist/pimath.js"
    },
    "./completions": {
      "types": "./types/completions/index.d.ts",
      "import": "./dist/completions.js"
    },
    "./codemirror": {
      "types": "./types/completions/codemirror.d.ts",
      "import": "./dist/codemirror.js"
    }
  },
  "./types/index.d.ts": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "test": "vitest",
    "test:quick": "vitest run --mode quick",
    "test:full": "vitest run --mode full",
    "test:unit": "vitest run --exclude \"tests/randomization/**\"",
    "test:random": "vitest run tests/randomization",
    "build": "node scripts/completions.mjs && tsc --p ./tsconfig-build.json && vite build",
    "docs:api": "typedoc",
    "api": "node scripts/api-sitemap.mjs",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg",
    "docs:dev": "vitepress dev docs",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:update": "npm run docs:sync && npm run docs:check && typedoc",
    "docs:build": "npm run docs:sync && npm run docs:check && typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "completions": "node scripts/completions.mjs"
  },
  "keywords": [
    "math",
    "algebra",
    "geometry",
    "fraction",
    "polynomial",
    "equation",
    "latex",
    "exercises",
    "education",
    "random",
    "typescript"
  ],
  "author": "Basil Gass",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilgass/PiMath.git"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@mdit/plugin-katex": "^1.1.3",
    "@types/eslint": "^9.6.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "katex": "^0.19.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "piexpression": "^0.1.6"
  },
  "homepage": "https://basilgass.github.io/PiMath/",
  "bugs": {
    "url": "https://github.com/basilgass/PiMath/issues"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  }
}
