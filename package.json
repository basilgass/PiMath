{
  "name": "pimath",
  "version": "0.3.0",
  "description": "A math library for teacher :)",
  "type": "module",
  "main": "dist/pimath.js",
  "module": "dist/pimath.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/pimath.js",
      "require": "./dist/pimath.js"
    }
  },
  "./types/index.d.ts": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "dev": "vite serve",
    "test": "vitest",
    "test:quick": "vitest run --mode quick",
    "test:full": "vitest run --mode full",
    "test:unit": "vitest run --exclude \"tests/randomization/**\"",
    "test:random": "vitest run tests/randomization",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "preview": "vite preview",
    "docs": "typedoc",
    "api": "node scripts/api-sitemap.mjs",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "math",
    "algebra",
    "geometry",
    "fraction",
    "polynomial",
    "equation",
    "latex",
    "exercises",
    "education",
    "random",
    "typescript"
  ],
  "author": "Basil Gass",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilgass/PiMath.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "markdown-it-mathjax3": "^4.3.2",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue-router": "^5.2.0"
  },
  "dependencies": {
    "piexpression": "^0.1.6"
  },
  "homepage": "https://basilgass.github.io/PiMath/",
  "bugs": {
    "url": "https://github.com/basilgass/PiMath/issues"
  }
}
